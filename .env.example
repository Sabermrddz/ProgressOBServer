# WebEtu Bot Environment Variables
# Copy this file to .env and fill in your credentials

# WebEtu API Credentials (Your university login)
WEBETU_USERNAME=your_username
WEBETU_PASSWORD=your_password

# Student Identifiers (might be different per student)
DIA_ID=39608221
IND_ID=38669075

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=883784883

# Schedule Configuration (in minutes)
CHECK_INTERVAL_MINUTES=30

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Network Configuration
REQUEST_TIMEOUT_SECONDS=10

# File Storage
GRADES_FILE=grades.json
TOKEN_FILE=token.json
LOG_FILE=webetu_bot.log

# Logging Configuration (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Feature Flags
CONSECUTIVE_FAILURES_ALERT=3
VERBOSE_MODE=false
